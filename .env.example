# ════════════════════════════════════════════════════════════
#  متغيرات البيئة لمشروع مسجد طه
#  ─────────────────────────────────────────────────────────
#  للتطوير المحلي: انسخ هذا الملف إلى .env واملأ القيم
#  على Render: أضف كل متغير في:
#    Dashboard → Service → Environment → Add Environment Variable
# ════════════════════════════════════════════════════════════

# ── أساسي (مطلوب) ────────────────────────────────────────
# مفتاح سري طويل وعشوائي — ولّده بـ:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-very-long-random-secret-key-here

# ── البيئة ───────────────────────────────────────────────
# True للتطوير المحلي فقط — اتركها False في الإنتاج
DEBUG=False

# المضيفون المسموح بهم (فصل بفواصل بدون مسافات)
ALLOWED_HOSTS=your-app.onrender.com,www.your-domain.com

# أصول CSRF الموثوقة (مطلوبة لـ HTTPS)
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://www.your-domain.com

# ── قاعدة البيانات ───────────────────────────────────────
# Render يُعيّنها تلقائياً — انسخها من لوحة PostgreSQL service
# صيغتها: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── تلغرام ───────────────────────────────────────────────
# احصل على التوكن من @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# للحصول على CHAT_ID: أرسل رسالة للبوت ثم افتح:
# https://api.telegram.org/bot<TOKEN>/getUpdates
# وابحث عن "chat":{"id": ...}
TELEGRAM_CHAT_ID=-1001234567890

# ── واتساب WAHA (اختياري) ────────────────────────────────
WAHA_RENDER_URL=https://your-waha-instance.onrender.com
WAHA_API_KEY=your-waha-api-key
